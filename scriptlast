-- ==================== ESP ====================
local espContainer = Instance.new("ScreenGui")
espContainer.Name = "ESPContainer"
espContainer.Parent = PlayerGui
espContainer.IgnoreGuiInset = true
espContainer.ResetOnSpawn = false

local labelsPool = {}

local function createEspLabel()
    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.SourceSansBold
    lbl.TextSize = 13
    lbl.TextStrokeTransparency = 0
    lbl.Parent = espContainer
    return lbl
end

local function clearEspLabels()
    for _, lbl in pairs(labelsPool) do
        lbl:Destroy()
    end
    table.clear(labelsPool)
end

local function isVisibleFrom(part, fromPos)
    local rayDir = (part.Position - fromPos).Unit * 1000
    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = {LocalPlayer.Character or game}
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    local result = workspace:Raycast(fromPos, rayDir, rayParams)
    return result and result.Instance == part
end

local function updateESP()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("Head") then
        clearEspLabels()
        return
    end
    local headPos = char.Head.Position
    local camera = workspace.CurrentCamera
    if not camera then return end

    -- Собираем все цели
    local targets = {}
    local allDescendants = workspace:GetDescendants()
    for _, obj in ipairs(allDescendants) do
        if obj:IsA("BasePart") and obj.Name ~= "Head" then
            local name = obj.Name
            local color = nil
            if table.find(ENTITY_NAMES, name) then
                color = COLORS.ENTITY
            elseif table.find(ITEM_NAMES, name) then
                color = COLORS.ITEM
            elseif table.find(HIDING_NAMES, name) then
                color = COLORS.HIDING
            elseif table.find(DOOR_NAMES, name) then
                color = COLORS.DOOR
            elseif table.find(TRAP_NAMES, name) then
                color = COLORS.TRAP
            end
            if color then
                table.insert(targets, {part = obj, color = color})
            end
        end
    end

    clearEspLabels()
    for _, target in ipairs(targets) do
        local part = target.part
        local distance = (part.Position - headPos).Magnitude
        if distance < 300 then -- дальность отрисовки
            if isVisibleFrom(part, headPos) then
                local screenPos, onScreen = camera:WorldToScreenPoint(part.Position)
                if onScreen then
                    local lbl = createEspLabel()
                    lbl.Position = UDim2.new(0, screenPos.X, 0, screenPos.Y)
                    lbl.TextColor3 = target.color
                    lbl.Text = string.format("%s [%dm]", part.Name, distance)
                    table.insert(labelsPool, lbl)
                end
            end
        end
    end
end

RunService.RenderStepped:Connect(updateESP)

-- Первичная очистка при старте, если персонаж уже есть
updateESP()

