local speedSlider = Instance.new("TextBox") -- проще Slider, но для совместимости используем TextBox с ручным вводом или простой стандартный Slider. Сделаем Slider.
-- Вместо TextBox используем кастомный ползунок из двух кнопок? Лучше стандартный Slider.
-- В Roblox есть UI Slider (Frame с ползунком). Создадим вручную.

local sliderFrame = Instance.new("Frame")
sliderFrame.Name = "SliderFrame"
sliderFrame.Size = UDim2.new(1, -40, 0, 20)
sliderFrame.Position = UDim2.new(0, 20, 0, 70)
sliderFrame.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
sliderFrame.BorderSizePixel = 0
sliderFrame.Parent = mainFrame

local sliderBar = Instance.new("Frame")
sliderBar.Name = "SliderBar"
sliderBar.Size = UDim2.new(0, 0, 1, 0) -- будет управляться
sliderBar.BackgroundColor3 = Color3.fromRGB(100, 200, 100)
sliderBar.BorderSizePixel = 0
sliderBar.Parent = sliderFrame

local sliderButton = Instance.new("TextButton")
sliderButton.Name = "SliderButton"
sliderButton.Size = UDim2.new(0, 16, 1, 0)
sliderButton.Position = UDim2.new(0, 0, 0, 0)
sliderButton.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
sliderButton.BorderSizePixel = 0
sliderButton.Text = ""
sliderButton.AutoButtonColor = false
sliderButton.Parent = sliderFrame

-- Значение скорости
local currentSpeed = DEFAULT_SPEED

local function updateSliderFromSpeed()
    local fraction = (currentSpeed - MIN_SPEED) / (MAX_SPEED - MIN_SPEED)
    local maxX = sliderFrame.AbsoluteSize.X - sliderButton.AbsoluteSize.X
    local x = fraction * maxX
    sliderButton.Position = UDim2.new(0, x, 0, 0)
    sliderBar.Size = UDim2.new(0, x + sliderButton.AbsoluteSize.X/2, 1, 0)
    speedLabel.Text = "Скорость: " .. math.floor(currentSpeed)
end

-- Установка скорости персонажу
local function applySpeed()
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = currentSpeed
        end
    end
end

-- Обработчики ползунка
local function moveSlider(input)
    local sizeX = sliderFrame.AbsoluteSize.X - sliderButton.AbsoluteSize.X
    local mouseX = input.Position.X - sliderFrame.AbsolutePosition.X - sliderButton.AbsoluteSize.X/2
    local fraction = math.clamp(mouseX / sizeX, 0, 1)
    currentSpeed = MIN_SPEED + fraction * (MAX_SPEED - MIN_SPEED)
    currentSpeed = math.floor(currentSpeed * 10) / 10 -- округление до 1 десятой
    updateSliderFromSpeed()
    applySpeed()
end

sliderButton.MouseButton1Down:Connect(function()
    -- Начинаем перетаскивание
    local connection
    connection = UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            moveSlider(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            if connection then
                connection:Disconnect()
            end
        end
    end)
end)

-- Можно также двигать ползунок кликом по полоске
sliderFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        moveSlider(input)
        -- также зажать и двигать
        local connection
        connection = UserInputService.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement then
                moveSlider(input)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                if connection then connection:Disconnect() end
            end
        end)
    end
end)

updateSliderFromSpeed()

